       return;
     }
     g_allow_show_until = base::TimeTicks();
+    g_keyboard_shown = true;  // patch 0043
     OnShowIme();
-  } else
+  } else {
+    g_keyboard_shown = false;  // patch 0043
     OnHideIme(ImeHiddenType::kDeactivate);
+  }
 }
 
 }  // namespace ui
--- a/src/ui/base/ime/neva/input_method_neva_observer.h
+++ b/src/ui/base/ime/neva/input_method_neva_observer.h
@@ -53,6 +53,8 @@ class COMPONENT_EXPORT(UI_BASE_IME) InputMethodNevaObserver
   // before asking for the keyboard; any other request (Blink's show-on-focus,
   // views::Textfield::OnFocus, the omnibox) is ignored.
   static void AllowShowOnce();
+  // chromium-native (patch 0043): LG's keyboard was opened by us and not hidden since.
+  static bool KeyboardShown();
 private:
   bool is_enabled_ = false;
 };
