+    g_keyboard_shown = false;  // patch 0043
     OnHideIme(ImeHiddenType::kDeactivate);
   }
 }
@@ -175,6 +192,7 @@ void InputMethodNevaObserver::OnInputMethodDestroyed(const InputMethod* input_me
   if (!is_enabled_)
     return;
 
+  g_keyboard_shown = false;  // patch 0043
   OnHideIme(ImeHiddenType::kDeactivate);
 }
 
