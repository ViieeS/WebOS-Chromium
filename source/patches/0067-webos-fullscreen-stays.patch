# why: Fullscreen (F11, the menu's button, or a page's requestFullscreen) went back to the normal window by itself
# 1-9 s later on some TVs (issue #39, 43NANO756PR webOS 6; every time in Beanjar on webOS 5.6, 6.5 and 10.3). Chrome
# itself sent wl_webos_shell_surface.set_state(0) after set_state(3), with no event from LSM in between. Neva's
# WebosShellSurfaceWrapper::SetFullscreen() sets the window bounds before WaylandToplevelWindow applies the new state,
# so that queued bounds request still says "normal"; desktop compositors replace it with their configure event, LSM
# sends none. When the request was applied (at the next layout before its frame was latched), Chrome saw
# fullscreen -> normal and left fullscreen. A race, so fast TVs mostly won it. Client-side state changes now also set
# the state of the requests still in flight. Minimize and LSM's own state events are unchanged.
diff --git a/src/ui/ozone/platform/wayland/host/wayland_toplevel_window.cc b/src/ui/ozone/platform/wayland/host/wayland_toplevel_window.cc
index ad8e1d4..e5a4ad5 100644
--- a/src/ui/ozone/platform/wayland/host/wayland_toplevel_window.cc
+++ b/src/ui/ozone/platform/wayland/host/wayland_toplevel_window.cc
@@ -987,6 +987,13 @@ void WaylandToplevelWindow::TriggerStateChanges(
   // TODO(crbug.com/40276379): Remove this once this is async.
   auto previous_state = applied_state().window_state;
   ForceApplyWindowStateDoNotUse(window_state);
+#if defined(USE_NEVA_APPRUNTIME)
+  // chromium-native (patch 0067): webOS's SetFullscreen() above set the window
+  // bounds (SetContentsBounds) before the new state was applied, so that bounds
+  // request still carries the old state. Applied later, it turned fullscreen
+  // back into the normal window 1-9 s after F11 (issue #39).
+  SetWindowStateOfInFlightRequests(window_state);
+#endif
   auto weak_this = AsWeakPtr();
   delegate()->OnWindowStateChanged(previous_state, window_state);
   if (!weak_this) {
diff --git a/src/ui/ozone/platform/wayland/host/wayland_window.cc b/src/ui/ozone/platform/wayland/host/wayland_window.cc
index 05a61ed..2146214 100644
--- a/src/ui/ozone/platform/wayland/host/wayland_window.cc
+++ b/src/ui/ozone/platform/wayland/host/wayland_window.cc
@@ -1880,4 +1880,13 @@ void WaylandWindow::ForceApplyWindowStateDoNotUse(
   applied_state_.window_state = window_state;
 }
 
+#if defined(USE_NEVA_APPRUNTIME)
+void WaylandWindow::SetWindowStateOfInFlightRequests(
+    PlatformWindowState window_state) {
+  for (auto& request : in_flight_requests_) {
+    request.state.window_state = window_state;
+  }
+}
+#endif
+
 }  // namespace ui
diff --git a/src/ui/ozone/platform/wayland/host/wayland_window.h b/src/ui/ozone/platform/wayland/host/wayland_window.h
index b7e8194..9ea2086 100644
--- a/src/ui/ozone/platform/wayland/host/wayland_window.h
+++ b/src/ui/ozone/platform/wayland/host/wayland_window.h
@@ -513,6 +513,13 @@ class WaylandWindow : public PlatformWindow,
   // DO NOT USE THIS unless it's really needed and okay to use.
   // TODO(crbug.com/40276379): Remove this.
   void ForceApplyWindowStateDoNotUse(PlatformWindowState window_state);
+#if defined(USE_NEVA_APPRUNTIME)
+  // chromium-native (patch 0067): also sets |window_state| in the state
+  // requests that are still in flight, so a queued request made before a
+  // client-side state change can't undo it when it is applied (webOS's shell
+  // sends no configure that would replace it).
+  void SetWindowStateOfInFlightRequests(PlatformWindowState window_state);
+#endif
 
   bool HasInFlightRequestsForStateForTesting() const {
     return !in_flight_requests_.empty();
