+void DesktopWindowTreeHostPlatform::EnsureActiveForKeyEvent() {
+  if (!GetWidget() || GetWidget()->IsActive() ||
+      !GetWidget()->CanActivate()) {
+    return;
+  }
+  // A bubble inside our window is active (it took aura activation from the
+  // content window): the key is for it. Activating the content window here
+  // closed the bubble on the first arrow key.
+  if (is_active_ && GetActiveBubbleWindow()) {
+    return;
+  }
+  // OnActivationChanged() ignores a repeated "true", so reset the cached state.
+  is_active_ = false;
+  OnActivationChanged(true);
+}
+
+aura::Window* DesktopWindowTreeHostPlatform::GetActiveBubbleWindow() {
+  wm::ActivationClient* client = wm::GetActivationClient(window());
+  aura::Window* active = client ? client->GetActiveWindow() : nullptr;
+  if (!active || active == GetContentWindow() || !window()->Contains(active) ||
+      !active->IsVisible()) {
+    return nullptr;
+  }
+  return active;
+}
+
+void DesktopWindowTreeHostPlatform::MoveFocusInActiveBubble(
+    ui::KeyEvent* event) {
+  if (event->handled() || event->type() != ui::EventType::kKeyPressed) {
+    return;
+  }
+  const ui::KeyboardCode key = event->key_code();
+  if (key != ui::VKEY_UP && key != ui::VKEY_DOWN && key != ui::VKEY_LEFT &&
+      key != ui::VKEY_RIGHT) {
+    return;
+  }
+  aura::Window* bubble = GetActiveBubbleWindow();
+  Widget* widget = bubble ? Widget::GetWidgetForNativeWindow(bubble) : nullptr;
+  if (FocusManager* fm = widget ? widget->GetFocusManager() : nullptr) {
+    fm->AdvanceFocus(/*reverse=*/key == ui::VKEY_UP || key == ui::VKEY_LEFT);
+    event->SetHandled();
+  }
+}
