+    // chromium-native (patch 0059): no on-device AI models on the TV, so no
+    // models manifest either (update.googleapis.com and a download from
+    // edgedl.me.gvt1.com at every start, despite --disable-component-update).
+    return;
     if (!g_browser_process) {
       return;
     }
