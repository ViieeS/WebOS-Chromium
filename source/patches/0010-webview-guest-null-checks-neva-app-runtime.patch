+    if (auto* client = neva_app_runtime::GetAppRuntimeContentBrowserClient())
+      client->SetCorsCorbDisabledForURL(cors_exception_pdf_url_, false);
   }
 #endif
 
@@ -1521,8 +1521,8 @@ void WebViewGuest::ResourceLoadComplete(
