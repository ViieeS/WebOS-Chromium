# why: Hardware video on webOS 4 (NDL API 1, CN_NDL_API=old). The old decoder takes only H.264, so the renderer keeps
# other codecs in software, and no video window is exported, since the old API does not use one.
--- a/src/content/renderer/media/cn_ndl_renderer.cc
+++ b/src/content/renderer/media/cn_ndl_renderer.cc
@@ -69,6 +69,11 @@
   const char* v = getenv(name);
   return v && *v ? atoi(v) : def;
 }
+// webOS 4 (NDL API 1, launcher sets CN_NDL_API=old): H.264 only, so other codecs stay in software (patch 0039).
+bool OldNdlApi() {
+  const char* s = getenv("CN_NDL_API");
+  return s && !strcmp(s, "old");
+}
 
