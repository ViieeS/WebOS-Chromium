+
 #include <optional>
 
 #include "base/auto_reset.h"
@@ -13,6 +16,7 @@
 #include "base/functional/callback_helpers.h"
 #include "base/no_destructor.h"
 #include "base/process/process.h"
+#include "base/strings/string_number_conversions.h"
 #include "base/threading/hang_watcher.h"
 #include "base/time/time.h"
 #include "base/types/strong_alias.h"
@@ -71,6 +75,18 @@ namespace chrome {
 
 namespace {
 
+// chromium-native (patch 0057): the app's launcher (bin/run, pid in
+// CN_LAUNCHER_PID) ends the app when Chrome quits. Chrome's own exit left a
+// black window behind on the TV; the launcher stops Chrome if it is still
+// running a few seconds later, then exits, and webOS closes the app.
+void CnAskLauncherToQuit() {
+  int pid = 0;
+  const char* s = getenv("CN_LAUNCHER_PID");
+  if (s && base::StringToInt(s, &pid) && pid > 1) {
+    kill(pid, SIGUSR2);
+  }
+}
