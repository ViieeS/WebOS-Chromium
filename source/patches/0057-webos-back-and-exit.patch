# why: The remote's Back and Chrome's Exit behave like a TV app. Back goes to the page first (YouTube on TV uses it);
# a Back the page doesn't use goes back in history, and on a tab's first page it shows "Press Back again to exit"
# (a webOS toast from bin/run) and a second Back within 3 s closes the app. Exit, and Chrome quitting in any other
# way, ask bin/run to end the app (SIGUSR2): Chrome's own exit left a black window on the TV. Infobars such as the
# --no-sandbox warning (patch 0027) can be reached with the arrows: Down from the toolbar, Up from the page.
diff --git a/src/chrome/browser/lifetime/application_lifetime_desktop.cc b/src/chrome/browser/lifetime/application_lifetime_desktop.cc
index 2cbba56..e2237f3 100644
--- a/src/chrome/browser/lifetime/application_lifetime_desktop.cc
+++ b/src/chrome/browser/lifetime/application_lifetime_desktop.cc
@@ -4,6 +4,9 @@
 
 #include "chrome/browser/lifetime/application_lifetime_desktop.h"
 
