+namespace {
+// chromium-native (patch 0057): the infobars (e.g. the --no-sandbox warning
+// from patch 0027) sit between the toolbar and the page. True if any is open
+// (the container's last child is its shadow).
+bool TvHasInfoBars(BrowserView* view) {
+  InfoBarContainerView* bars = view->infobar_container();
+  return bars && bars->GetVisible() && bars->children().size() > 1;
+}
+
+// chromium-native (patch 0057): Up from the page: the infobars if any are
+// open, else the toolbar.
+void TvFocusAbovePage(BrowserView* view) {
+  if (TvHasInfoBars(view)) {
+    view->infobar_container()->SetPaneFocusAndFocusDefault();
+  } else {
+    view->FocusToolbar();
+  }
+}
+
+// chromium-native (patch 0057): the remote's Back on a page that did not use
+// it: back in history; on the tab's first page (the New Tab page after start)
+// bin/run shows "Press Back again to exit" (SIGUSR1, see
+// package/launcher/cnrun.c) and a second Back within 3 s closes the app.
+void TvRemoteBack(BrowserView* view) {
+  static base::TimeTicks exit_armed;
+  Browser* browser = view->browser();
+  if (chrome::CanGoBack(browser)) {
+    exit_armed = base::TimeTicks();
+    chrome::GoBack(browser, WindowOpenDisposition::CURRENT_TAB);
+    return;
+  }
+  const base::TimeTicks now = base::TimeTicks::Now();
+  if (!exit_armed.is_null() && now - exit_armed < base::Seconds(3)) {
+    exit_armed = base::TimeTicks();
+    chrome::ExecuteCommand(browser, IDC_EXIT);
+    return;
+  }
+  exit_armed = now;
+  int pid = 0;
+  const char* s = getenv("CN_LAUNCHER_PID");
+  if (s && base::StringToInt(s, &pid) && pid > 1) {
+    kill(pid, SIGUSR1);
+  }
+}
