# why: Chrome's media session calls to com.webos.service.mediacontroller fail without a luna handle, so webOS never
# knew media was playing and the screen saver came on. The handle-less path counts playing media sessions and
# writes the count to $CN_PLAYSTATE_FILE; the launcher answers the screen saver from it.
--- a/src/base/neva/webos/luna_service_client.cc
+++ b/src/base/neva/webos/luna_service_client.cc
@@ -16,13 +16,18 @@
 
