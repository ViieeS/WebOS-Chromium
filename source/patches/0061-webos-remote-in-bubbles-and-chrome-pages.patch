+// chromium-native (patch 0061): bubbles and dialogs ("Bookmark added", the
+// profile menu, permission prompts) are widgets of their own, outside the
+// browser window's handler above, and views moves focus in them only with Tab,
+// which the remote doesn't have. Here the arrows move focus between their
+// controls: Up and Left go back, Down and Right forward. In a text field Left
+// and Right move the caret until it reaches the end. Web contents in a bubble
+// (extension popups, tab search) and open menus keep their keys. One handler
+// for all windows (aura::Env), installed with the first browser window.
+class TvDialogKeyHandler : public ui::EventHandler {
+ public:
+  void OnKeyEvent(ui::KeyEvent* event) override {
+    if (event->type() != ui::EventType::kKeyPressed ||
+        (event->flags() & (ui::EF_SHIFT_DOWN | ui::EF_CONTROL_DOWN |
+                           ui::EF_ALT_DOWN | ui::EF_COMMAND_DOWN))) {
+      return;
+    }
+    const ui::KeyboardCode key = event->key_code();
+    if (key != ui::VKEY_UP && key != ui::VKEY_DOWN && key != ui::VKEY_LEFT &&
+        key != ui::VKEY_RIGHT) {
+      return;
+    }
+    if (views::MenuController::GetActiveInstance()) {
+      return;
+    }
+    aura::Window* target = static_cast<aura::Window*>(event->target());
+    views::Widget* widget =
+        target ? views::Widget::GetWidgetForNativeView(target) : nullptr;
+    if (!widget || !widget->widget_delegate() ||
+        !widget->widget_delegate()->AsDialogDelegate()) {
+      return;  // the browser window (handled above), menus, the omnibox popup
+    }
+    views::FocusManager* fm = widget->GetFocusManager();
+    views::View* fv = fm ? fm->GetFocusedView() : nullptr;
+    if (!fv || views::IsViewClass<views::WebView>(fv)) {
+      return;
+    }
+    if (key == ui::VKEY_LEFT || key == ui::VKEY_RIGHT) {
+      if (auto* tf = views::AsViewClass<views::Textfield>(fv)) {
+        const size_t len = tf->GetText().size();
+        const gfx::Range r = tf->GetSelectedRange();
+        const bool all = len == 0 || (r.GetMin() == 0 && r.GetMax() == len);
+        const bool at_edge =
+            r.is_empty() && r.start() == (key == ui::VKEY_LEFT ? 0 : len);
+        if (!all && !at_edge) {
+          return;  // move the caret
+        }
+      }
+    }
+    fm->AdvanceFocus(/*reverse=*/key == ui::VKEY_UP || key == ui::VKEY_LEFT);
+    event->StopPropagation();
+  }
+};
 }  // namespace
