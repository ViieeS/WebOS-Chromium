   wl_subcompositor* subcompositor = connection_->subcompositor();
-  DCHECK(subcompositor);
+  if (!subcompositor) {
+    // chromium-native (patch 0036): a compositor without wl_subcompositor (webOS 4.4) cannot show subsurfaces.
+    static bool log_once = false;
+    if (!log_once) {
+      log_once = true;
+      LOG(ERROR) << "No wl_subcompositor: subsurfaces are off";
+    }
+    return wl::Object<wl_subsurface>();
+  }
   wl::Object<wl_subsurface> subsurface(wl_subcompositor_get_subsurface(
       subcompositor, surface_.get(), parent->surface_.get()));
   return subsurface;
