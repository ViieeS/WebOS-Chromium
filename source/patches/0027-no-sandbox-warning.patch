# why: Removes the "unsupported command-line flag" bars for --no-sandbox and --disable-site-isolation-trials; the flags
# themselves stay. Chrome's Linux sandbox needs user namespaces or a setuid helper: the TV kernel has no user
# namespaces and a Developer Mode app cannot install setuid files. The app still runs as its own user inside
# webOS's app jail. One renderer for all sites keeps memory use low.
diff --git a/src/chrome/browser/ui/startup/bad_flags_prompt.cc b/src/chrome/browser/ui/startup/bad_flags_prompt.cc
index 3eae2d1..d053604 100644
--- a/src/chrome/browser/ui/startup/bad_flags_prompt.cc
+++ b/src/chrome/browser/ui/startup/bad_flags_prompt.cc
@@ -90,7 +90,7 @@ const char* const kBadFlags[] = {
     sandbox::policy::switches::kDisableLandlockSandbox,
     sandbox::policy::switches::kDisableSeccompFilterSandbox,
     sandbox::policy::switches::kDisableSetuidSandbox,
-    sandbox::policy::switches::kNoSandbox,
+    // chromium-native (patch 0027): not listed; see the patch header.
 #if BUILDFLAG(IS_WIN)
     sandbox::policy::switches::kAllowThirdPartyModules,
 #endif
@@ -225,7 +225,8 @@ static const std::variant<const base::Feature*, const char*>
         &features::kIsolatedWebAppDevMode,
 
         // This flag disables site isolation.
-        switches::kDisableSiteIsolation,
+        // chromium-native (patch 0027): not listed, run.sh needs
+        // --disable-site-isolation-trials (one renderer for all sites).
 
 #if BUILDFLAG(IS_ANDROID)
         &chrome::android::kCommandLineOnNonRooted,
