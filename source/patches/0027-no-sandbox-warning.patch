# why: Chrome's warning bar for --no-sandbox shows at every start, as in stock Chrome, without the X. Its buttons are
# stacked on the right and look the same: "Hide" (until the next start), and from the third time the bar is shown
# "Don't show again" under it (kept in Local State), so everyone sees the warning at least twice. This build needs
# --no-sandbox: Chrome's Linux sandbox needs user namespaces or a setuid helper, the TV kernel has no user namespaces
# and a Developer Mode app can't install setuid files. The browser still runs as its own user inside webOS's app jail.
diff --git a/src/chrome/browser/prefs/browser_prefs.cc b/src/chrome/browser/prefs/browser_prefs.cc
index 48394ef..e3d8f59 100644
--- a/src/chrome/browser/prefs/browser_prefs.cc
+++ b/src/chrome/browser/prefs/browser_prefs.cc
@@ -1389,6 +1389,10 @@ void RegisterLocalState(PrefRegistrySimple* registry) {
   // Call outs to individual subsystems that register Local State (browser-wide)
   // prefs en masse. See RegisterProfilePrefs for per-profile prefs. Please
   // keep this list alphabetized.
+  // chromium-native (patch 0027): the bad-flags bar's "Don't show again" and
+  // how often the bar was shown.
+  registry->RegisterBooleanPref("chromium_native.bad_flags_bar_hidden", false);
+  registry->RegisterIntegerPref("chromium_native.bad_flags_bar_shown", 0);
 #if BUILDFLAG(IS_ANDROID)
   accessibility::AccessibilityPrefsController::RegisterLocalStatePrefs(
       registry);
