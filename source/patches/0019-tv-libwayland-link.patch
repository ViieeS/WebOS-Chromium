diff --git a/src/third_party/wayland/cn_wayland_egl.c b/src/third_party/wayland/cn_wayland_egl.c
new file mode 100644
index 0000000..278b9c997
--- /dev/null
+++ b/src/third_party/wayland/cn_wayland_egl.c
@@ -0,0 +1,85 @@
+// chromium-native (patch 0019): wl_egl_window_* from the TV, found at first use.
+//
+// Chrome links the TV's libwayland-client (one libwayland per wl_display, see BUILD.gn), and used to link
+// libwayland-egl.so.1 the same way. Not every LG TV has a file of that name: an LG C1 (webOS 6.5.3) refused to
+// load chrome at all ("libwayland-egl.so.1: cannot open shared object file", splash then nothing). In webosbrew's
+// firmware data webOS 5+ models have libwayland-egl.so.1, webOS 3/4 only libwayland-egl.so.0 and .so, and on ARM
+// Mali TVs the functions are part of the GPU driver itself (libwayland-egl only depends on libmali). The functions
+// must come from the TV's GPU driver stack either way, because its EGL reads the wl_egl_window they create. So,
+// like SDL does, look them up at run time in the libraries that can have them, in this order.
+#include <dlfcn.h>
+#include <pthread.h>
+#include <stddef.h>
+#include <stdio.h>
+
+struct wl_surface;
+struct wl_egl_window;
+
+#define CN_HIDDEN __attribute__((visibility("hidden")))  // never interpose the TV driver's own calls
+
+static struct wl_egl_window* (*cn_create)(struct wl_surface*, int, int);
+static void (*cn_destroy)(struct wl_egl_window*);
+static void (*cn_resize)(struct wl_egl_window*, int, int, int, int);
+static void (*cn_get_attached_size)(struct wl_egl_window*, int*, int*);
+static pthread_once_t cn_once = PTHREAD_ONCE_INIT;
+
+static void cn_load(void) {
+  // libEGL.so.1 is the TV's EGL (Chrome's own ANGLE copy is libEGL.so, deliberately not in this list).
+  static const char* const kLibs[] = {
+      "libwayland-egl.so.1", "libwayland-egl.so", "libwayland-egl.so.0", "libEGL.so.1",
+      "libmali.so.0",        "libmali.so.1",      "libmali.so",
+  };
+  for (size_t i = 0; i < sizeof(kLibs) / sizeof(kLibs[0]); i++) {
+    void* h = dlopen(kLibs[i], RTLD_NOW | RTLD_LOCAL);
+    if (!h) {
+      continue;
+    }
+    void* create = dlsym(h, "wl_egl_window_create");
+    void* destroy = dlsym(h, "wl_egl_window_destroy");
+    void* resize = dlsym(h, "wl_egl_window_resize");
+    if (!create || !destroy || !resize) {
+      dlclose(h);
+      continue;
+    }
+    *(void**)&cn_create = create;
+    *(void**)&cn_destroy = destroy;
+    *(void**)&cn_resize = resize;
+    *(void**)&cn_get_attached_size = dlsym(h, "wl_egl_window_get_attached_size");
+    fprintf(stderr, "cn: wl_egl_window from %s\n", kLibs[i]);
+    return;  // keep h open for the life of the process
+  }
+  fprintf(stderr, "cn: no library on this TV has wl_egl_window_create; GPU drawing is unavailable\n");
+}
+
+CN_HIDDEN struct wl_egl_window* wl_egl_window_create(struct wl_surface* surface, int width, int height) {
+  pthread_once(&cn_once, cn_load);
+  return cn_create ? cn_create(surface, width, height) : NULL;
+}
+
+CN_HIDDEN void wl_egl_window_destroy(struct wl_egl_window* window) {
+  pthread_once(&cn_once, cn_load);
+  if (cn_destroy && window) {
+    cn_destroy(window);
+  }
+}
+
+CN_HIDDEN void wl_egl_window_resize(struct wl_egl_window* window, int width, int height, int dx, int dy) {
+  pthread_once(&cn_once, cn_load);
+  if (cn_resize && window) {
+    cn_resize(window, width, height, dx, dy);
+  }
+}
+
+CN_HIDDEN void wl_egl_window_get_attached_size(struct wl_egl_window* window, int* width, int* height) {
+  pthread_once(&cn_once, cn_load);
+  if (cn_get_attached_size && window) {
+    cn_get_attached_size(window, width, height);
+  } else {
+    if (width) {
+      *width = 0;
+    }
+    if (height) {
+      *height = 0;
+    }
+  }
+}
