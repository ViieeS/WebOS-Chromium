# why: One build for older TVs (glibc 2.24, libwayland 1.10 and newer).
# - The compat build links against an older glibc sysroot (container/build-sysroot-compat.sh). gn arg
#   cn_glibc_compat adds --allow-shlib-undefined, because the newer TV libraries in that sysroot reference newer
#   glibc versions; an older TV loads its own libraries.
# - wayland-scanner 1.20+ writes request stubs that call wl_proxy_marshal_flags (libwayland 1.20+). With
#   cn_glibc_compat the stubs use wl_proxy_marshal and wl_proxy_destroy, which every libwayland since 1.10 has.
diff --git a/src/build/config/cn_compat.gni b/src/build/config/cn_compat.gni
new file mode 100644
index 0000000..8c1a425
--- /dev/null
+++ b/src/build/config/cn_compat.gni
@@ -0,0 +1,7 @@
+# chromium-native (patch 0031): build of the browser for older LG TVs.
+declare_args() {
+  # The "compat" build for webOS 5-8 (glibc 2.28-2.31, libwayland 1.10-1.19). It is linked against a glibc 2.28
+  # sysroot (container/build-sysroot-compat.sh), and Wayland protocol code is generated for the libwayland API
+  # before 1.20, which every libwayland since 1.10 provides. The result also runs on newer TVs.
+  cn_glibc_compat = false
+}
diff --git a/src/build/config/compiler/BUILD.gn b/src/build/config/compiler/BUILD.gn
index 4317238..d950720 100644
--- a/src/build/config/compiler/BUILD.gn
+++ b/src/build/config/compiler/BUILD.gn
@@ -10,6 +10,7 @@ import("//build/config/cast.gni")
 import("//build/config/chrome_build.gni")
 import("//build/config/chromeos/args.gni")
 import("//build/config/clang/clang.gni")
+import("//build/config/cn_compat.gni")
 import("//build/config/compiler/compiler.gni")
 import("//build/config/compiler_cpu_abi.gn")
 import("//build/config/coverage/coverage.gni")
@@ -332,6 +333,14 @@ config("compiler") {
   defines = []
   configs = []
 
+  # chromium-native (patch 0031): the compat build links against glibc 2.28,
+  # but the other TV libraries in the sysroot (webOS 10) were built against a
+  # newer glibc. Their own undefined references don't matter: on an older TV
+  # its own, older libraries are loaded.
+  if (cn_glibc_compat && current_cpu == "arm") {
+    ldflags += [ "-Wl,--allow-shlib-undefined" ]
+  }
+
   # System-specific flags. If your compiler flags apply to one of the
   # categories here, add it to the associated file to keep this shared config
   # smaller.
diff --git a/src/third_party/wayland/BUILD.gn b/src/third_party/wayland/BUILD.gn
index 4c47cfa..8174a4b 100644
--- a/src/third_party/wayland/BUILD.gn
+++ b/src/third_party/wayland/BUILD.gn
@@ -1,6 +1,7 @@
