 # found in the LICENSE file.
+import("//build/config/cn_compat.gni")
 import("//build/config/linux/pkg_config.gni")
 import("//build/config/sysroot.gni")
 import("//third_party/wayland/features.gni")
@@ -329,6 +330,13 @@ config("wayland_scanner_config") {
   ]
 
   include_dirs = [ "include/" ]
+
+  # chromium-native (patch 0031): generate request stubs for the libwayland
+  # API before 1.20 (wl_proxy_marshal*, then wl_proxy_destroy) instead of
+  # wl_proxy_marshal_flags, so the browser runs with older TVs' libwayland.
+  if (cn_glibc_compat) {
+    defines = [ "CN_SCANNER_PRE_1_20" ]
+  }
 }
 
