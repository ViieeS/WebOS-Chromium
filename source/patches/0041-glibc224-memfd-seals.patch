+  // Raw syscall: glibc < 2.27 (webOS 4 TVs) has no memfd_create() (same as mojo/core/channel_linux.cc).
+  int fd = static_cast<int>(
+      syscall(__NR_memfd_create, "wasm_memory_map_descriptor", MFD_CLOEXEC));
   if (fd == -1) return {};
