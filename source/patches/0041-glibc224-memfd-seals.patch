# why: glibc 2.24 (webOS 4) has no memfd_create() and no F_ADD_SEALS/F_SEAL_* constants (added in 2.27). v8 calls
# memfd_create through the raw syscall, as mojo already does, and mojo defines the kernel's seal values when the
# headers lack them.
--- a/src/mojo/core/channel_linux.cc
+++ b/src/mojo/core/channel_linux.cc
@@ -13,6 +13,19 @@
 #include <sys/utsname.h>
 #include <unistd.h>
 
+// glibc < 2.27 (webOS 4 TVs) does not define the memfd seal fcntl constants, and <linux/fcntl.h> clashes with
+// <fcntl.h>. Kernel ABI values from include/uapi/linux/fcntl.h.
+#ifndef F_ADD_SEALS
+#define F_ADD_SEALS (1024 + 9)
+#define F_GET_SEALS (1024 + 10)
+#endif
+#ifndef F_SEAL_SEAL
+#define F_SEAL_SEAL 0x0001
+#define F_SEAL_SHRINK 0x0002
+#define F_SEAL_GROW 0x0004
+#define F_SEAL_WRITE 0x0008
+#endif
+
 #include <algorithm>
 #include <atomic>
 #include <cstring>
--- a/src/v8/src/wasm/wasm-memory-map-descriptor.cc
+++ b/src/v8/src/wasm/wasm-memory-map-descriptor.cc
@@ -5,8 +5,10 @@
 #include "include/v8config.h"  // For V8_TARGET_OS_LINUX.
 
 #if V8_TARGET_OS_LINUX
+#include <linux/memfd.h>
 #include <sys/mman.h>
 #include <sys/stat.h>
