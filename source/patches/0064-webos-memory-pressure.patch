+#if defined(OS_WEBOS)
+namespace {
+
+// chromium-native (patch 0064): desktop Linux has no system evaluator, so the
+// browser never saw memory pressure and kept every cache and tab until
+// webOS's memory manager (memchute) closed the whole app. This one reads
+// MemAvailable every 2 s: below CN_MEM_MODERATE_MB (default 160) moderate,
+// below CN_MEM_CRITICAL_MB (default 100) critical. Leaving a level needs
+// 20 MB more than entering it. Critical is re-sent every 5 s, moderate every
+// 30 s, as on Windows. Listeners then purge caches, and urgent discarding
+// unloads background tabs (patch 0064, ChromeBrowserMainExtraParts...).
+class SystemMemoryPressureEvaluatorWebos
+    : public SystemMemoryPressureEvaluator {
+ public:
+  explicit SystemMemoryPressureEvaluatorWebos(
+      std::unique_ptr<MemoryPressureVoter> voter)
+      : SystemMemoryPressureEvaluator(std::move(voter)),
+        moderate_kb_(EnvMb("CN_MEM_MODERATE_MB", 160) * 1024),
+        critical_kb_(EnvMb("CN_MEM_CRITICAL_MB", 100) * 1024) {
+    LOG(WARNING) << "cn-mem: memory pressure from MemAvailable, moderate < "
+                 << moderate_kb_ / 1024 << " MB, critical < "
+                 << critical_kb_ / 1024 << " MB";
+    timer_.Start(
+        FROM_HERE, base::Seconds(2),
+        base::BindRepeating(&SystemMemoryPressureEvaluatorWebos::Check,
+                            base::Unretained(this)));
+  }
+
+ private:
+  static long EnvMb(const char* name, long def) {
+    const char* v = getenv(name);
+    const long n = v ? atol(v) : 0;
+    return n > 0 ? n : def;
+  }
+
+  static long AvailableKb() {
+    FILE* f = fopen("/proc/meminfo", "re");
+    if (!f) {
+      return -1;
+    }
+    char line[128];
+    long kb = -1;
+    while (fgets(line, sizeof(line), f)) {
+      if (sscanf(line, "MemAvailable: %ld kB", &kb) == 1) {
+        break;
+      }
+      kb = -1;
+    }
+    fclose(f);
+    return kb;
+  }
+
+  void Check() {
+    const long kb = AvailableKb();
+    if (kb < 0) {
+      return;
+    }
+    const base::MemoryPressureLevel old = current_vote();
+    const long slack = 20 * 1024;
+    base::MemoryPressureLevel level = base::MEMORY_PRESSURE_LEVEL_NONE;
+    if (kb < critical_kb_ ||
+        (old == base::MEMORY_PRESSURE_LEVEL_CRITICAL &&
+         kb < critical_kb_ + slack)) {
+      level = base::MEMORY_PRESSURE_LEVEL_CRITICAL;
+    } else if (kb < moderate_kb_ ||
+               (old != base::MEMORY_PRESSURE_LEVEL_NONE &&
+                kb < moderate_kb_ + slack)) {
+      level = base::MEMORY_PRESSURE_LEVEL_MODERATE;
+    }
+    const base::TimeTicks now = base::TimeTicks::Now();
+    bool notify = false;
+    if (level != old) {
+      notify = true;
+      LOG(WARNING) << "cn-mem: pressure " << static_cast<int>(old) << " -> "
+                   << static_cast<int>(level) << ", MemAvailable "
+                   << kb / 1024 << " MB";
+    } else if (level == base::MEMORY_PRESSURE_LEVEL_CRITICAL) {
+      notify = now - last_notify_ >= base::Seconds(5);
+    } else if (level == base::MEMORY_PRESSURE_LEVEL_MODERATE) {
+      notify = now - last_notify_ >= base::Seconds(30);
+    }
+    SetCurrentVote(level);
+    SendCurrentVote(notify);
+    if (notify) {
+      last_notify_ = now;
+    }
+  }
+
+  const long moderate_kb_;
+  const long critical_kb_;
+  base::TimeTicks last_notify_;
+  base::RepeatingTimer timer_;
+};
+
+}  // namespace
+#endif  // defined(OS_WEBOS)
