 #include "third_party/re2/src/re2/re2.h"
 
@@ -24,6 +27,9 @@ namespace ui {
 
 namespace {
 
+// chromium-native (patch 0058): set when the (one) watcher is being destroyed.
+std::atomic<bool> g_cn_watcher_shutting_down{false};
+
 // Formats the |message| by removing '@' char followed by any digits until the
 // next char. Also removes new line, tab and carriage-return.
 void FormatErrorMessage(std::string* message) {
@@ -144,6 +150,13 @@ WaylandEventWatcher::~WaylandEventWatcher() {
   DCHECK(!watching_);
 }
 
+void WaylandEventWatcher::StopThread() {
+  // chromium-native (patch 0058): let the watcher thread leave a wait for the
+  // UI thread (see WlDisplayDispatchPendingQueue), then join it.
+  g_cn_watcher_shutting_down.store(true);
+  thread_.reset();
+}
+
