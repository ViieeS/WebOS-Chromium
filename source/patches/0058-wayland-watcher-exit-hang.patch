     base::OnceCallback<void()> shutdown_cb) {
   DCHECK(shutdown_cb_.is_null());
@@ -302,12 +315,28 @@ void WaylandEventWatcher::WlDisplayCancelRead() {
 void WaylandEventWatcher::WlDisplayDispatchPendingQueue() {
   if (use_threaded_polling_ &&
       watching_thread_task_runner_->BelongsToCurrentThread()) {
-    base::WaitableEvent event;
+    // chromium-native (patch 0058): `event` is shared with the UI thread, and
+    // a timed wait. When the UI thread is already shutting down it never runs
+    // the task (it is waiting in thread_->Stop() for this thread), and an
+    // untimed Wait() hung Chrome's exit with the window gone. The task signals
+    // before it dispatches, so a missed signal only means the events are
+    // dispatched later or, at exit, not at all.
+    auto event = base::MakeRefCounted<base::RefCountedData<base::WaitableEvent>>();
     auto cb = base::BindOnce(
-        &WaylandEventWatcher::WlDisplayDispatchPendingQueueInternal, weak_this_,
-        &event);
+        [](base::WeakPtr<WaylandEventWatcher> watcher,
+           scoped_refptr<base::RefCountedData<base::WaitableEvent>> event) {
+          event->data.Signal();
+          if (watcher) {
+            watcher->WlDisplayDispatchPendingQueueInternal(nullptr);
+          }
+        },
+        weak_this_, event);
     ui_thread_task_runner_->PostTask(FROM_HERE, std::move(cb));
-    event.Wait();
+    while (!event->data.TimedWait(base::Milliseconds(500))) {
+      if (g_cn_watcher_shutting_down.load()) {
+        return;
+      }
+    }
   } else {
     WlDisplayDispatchPendingQueueInternal(nullptr);
   }
