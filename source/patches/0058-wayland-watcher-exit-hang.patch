# why: Chrome's exit could hang after its window closed (black screen until bin/run killed it, 3 of 5 exits in the
# twin). Stack samples of the hung browser: the main thread joins the Wayland watcher thread ("wayland-fd") in
# WaylandEventWatcher's destructor, while that thread waits, untimed, for a task it posted to the main thread
# (WlDisplayDispatchPendingQueue), which the main thread no longer runs. The watcher thread now waits in 500 ms
# steps and gives up when the watcher stops. The thread is joined in WaylandEventWatcherGlib's destructor, before
# its GPollFD is freed: joined later, a thread still in GLib wrote into the freed memory (heap corruption at exit).
diff --git a/src/ui/events/platform/wayland/wayland_event_watcher.cc b/src/ui/events/platform/wayland/wayland_event_watcher.cc
index 0e94679..b112c17 100644
--- a/src/ui/events/platform/wayland/wayland_event_watcher.cc
+++ b/src/ui/events/platform/wayland/wayland_event_watcher.cc
@@ -6,17 +6,20 @@
 
 #include <wayland-client-core.h>
 
+#include <atomic>
 #include <cstring>
 
 #include "base/check.h"
 #include "base/environment.h"
 #include "base/logging.h"
+#include "base/memory/ref_counted.h"
 #include "base/nix/xdg_util.h"
 #include "base/strings/string_util.h"
