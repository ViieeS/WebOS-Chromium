+bool BrowserView::HandleTvRemoteKey(ui::KeyEvent* event) {
+  if (event->type() != ui::EventType::kKeyPressed ||
+      (event->flags() & (ui::EF_SHIFT_DOWN | ui::EF_CONTROL_DOWN |
+                         ui::EF_ALT_DOWN | ui::EF_COMMAND_DOWN))) {
+    return false;
+  }
+  // An open menu (app menu, context menu) handles its own keys.
+  if (views::MenuController::GetActiveInstance()) {
+    return false;
+  }
+  const ui::KeyboardCode key = event->key_code();
+  // chromium-native (patch 0021): OK on a focused text field (page or omnibox)
+  // opens LG's keyboard instead of submitting. While that keyboard is open its
+  // Enter key reaches us too: then let it through (submit) and re-arm.
+  if (key == ui::VKEY_RETURN && GetWidget()) {
+    ui::InputMethod* im = GetWidget()->GetInputMethod();
+    ui::TextInputClient* client = im ? im->GetTextInputClient() : nullptr;
+    if (client && client->GetTextInputType() != ui::TEXT_INPUT_TYPE_NONE) {
+      const uintptr_t id = reinterpret_cast<uintptr_t>(client);
+      if (tv_keyboard_client_ != id) {
+        tv_keyboard_client_ = id;
+        ui::InputMethodNevaObserver::AllowShowOnce();
+        im->SetVirtualKeyboardVisibilityIfEnabled(true);
+        return true;
+      }
+      tv_keyboard_client_ = 0;
+      return false;
+    }
+    tv_keyboard_client_ = 0;
+    return false;
+  }
+  if (key == ui::VKEY_ESCAPE) {
+    tv_keyboard_client_ = 0;
+  }
+  if (key != ui::VKEY_UP && key != ui::VKEY_DOWN && key != ui::VKEY_LEFT &&
+      key != ui::VKEY_RIGHT && key != ui::VKEY_ESCAPE) {
+    return false;
+  }
+  views::FocusManager* fm = GetFocusManager();
+  views::View* fv = fm ? fm->GetFocusedView() : nullptr;
+  if (!fv) {
+    return false;
+  }
+  views::View* tabs = horizontal_tab_strip_region_view_.get();
+  const bool in_tabs = tabs && tabs->GetVisible() && tabs->Contains(fv);
+  const bool in_toolbar = toolbar_ && toolbar_->Contains(fv);
+  if (!in_tabs && !in_toolbar) {
+    return false;  // the page, menus and dialogs handle their own keys
+  }
+  // In a text field (the omnibox) the arrows stay with the text while the user
+  // edits; with all text selected (just focused) they move focus.
+  auto* tf = views::AsViewClass<views::Textfield>(fv);
+  bool tf_all = false;
+  bool at_start = false;
+  bool at_end = false;
+  if (tf) {
+    const size_t len = tf->GetText().size();
+    const gfx::Range r = tf->GetSelectedRange();
+    tf_all = len == 0 || (r.GetMin() == 0 && r.GetMax() == len);
+    at_start = r.is_empty() && r.start() == 0;
+    at_end = r.is_empty() && r.start() == len;
+  }
+  views::View* page = GetActiveContentsWebView();
+  switch (key) {
+    case ui::VKEY_DOWN:
+      if (tf && !tf_all) {
+        // Moving into the omnibox suggestions: release the webOS IME so the
+        // next OK reaches the omnibox and opens the suggestion instead of
+        // reopening the virtual keyboard (patch 0018).
+        if (in_toolbar && GetWidget() && GetWidget()->GetInputMethod()) {
+          GetWidget()->GetInputMethod()->SetVirtualKeyboardVisibilityIfEnabled(
+              false);
+        }
+        return false;  // omnibox suggestions
+      }
+      if (in_tabs) {
+        FocusToolbar();
+      } else if (page) {
+        page->RequestFocus();
+        // Chrome's own pages: focus their first element (patch 0017).
+        RunTvWebUiNav("down", /*from_edge=*/true);
+      }
+      return true;
+    case ui::VKEY_UP:
+      if (tf && !tf_all) {
+        if (in_toolbar && GetWidget() && GetWidget()->GetInputMethod()) {
+          GetWidget()->GetInputMethod()->SetVirtualKeyboardVisibilityIfEnabled(
+              false);
+        }
+        return false;
+      }
+      if (in_toolbar && tabs && tabs->GetVisible()) {
+        static_cast<views::AccessiblePaneView*>(
+            horizontal_tab_strip_region_view_.get())
+            ->SetPaneFocusAndFocusDefault();
+      }
+      return true;
+    case ui::VKEY_LEFT:
+    case ui::VKEY_RIGHT:
+      if (tf && !tf_all && !(key == ui::VKEY_LEFT ? at_start : at_end)) {
+        return false;  // move the caret
+      }
+      fm->AdvanceFocus(/*reverse=*/key == ui::VKEY_LEFT);
+      return true;
+    case ui::VKEY_ESCAPE:
+      if (tf && !tf_all) {
+        return false;  // the omnibox reverts the edit first
+      }
+      if (page) {
+        page->RequestFocus();
+      }
+      return true;
+    default:
+      return false;
+  }
+}
