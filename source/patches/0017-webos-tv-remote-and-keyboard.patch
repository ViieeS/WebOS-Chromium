+namespace {
+// chromium-native (webOS, patch 0017): Blink's spatial navigation does not look
+// into shadow DOM, and Chrome's own pages (New Tab page, settings, history) are
+// built from it, so the remote could not reach the search box or the shortcuts.
+// Moves focus to the nearest visible focusable element in direction `d`
+// ("up", "down", "left", "right"), searching every open shadow root. With
+// `edge` true it starts from the top edge of the page. Returns the focused
+// element's tag (and id), or false if nothing lies in that direction.
+constexpr char16_t kTvWebUiNavScript[] = uR"JS((function(d, edge) {
+  let cur = document.activeElement;
+  while (cur && cur.shadowRoot && cur.shadowRoot.activeElement) {
+    cur = cur.shadowRoot.activeElement;
+  }
+  if (edge || !cur || cur === document.body ||
+      cur === document.documentElement) {
+    cur = null;
+  }
+  const W = innerWidth, H = innerHeight;
+  const o = cur ? cur.getBoundingClientRect()
+                : {left: W / 2, right: W / 2, top: -1, bottom: -1};
+  const sel = 'a[href],button,input:not([type=hidden]),select,textarea,' +
+      '[tabindex],[role=button],[role=link],[role=menuitem],[role=tab],' +
+      '[role=option],[contenteditable=true]';
+  // Distance across the direction of travel: 0 when the element overlaps the
+  // current one in that axis (a wide search box right below counts as straight
+  // down), else the gap between them.
+  const hgap = (r) => Math.max(0, Math.max(r.left, o.left) - Math.min(r.right, o.right));
+  const vgap = (r) => Math.max(0, Math.max(r.top, o.top) - Math.min(r.bottom, o.bottom));
+  const ocx = (o.left + o.right) / 2, ocy = (o.top + o.bottom) / 2;
+  let best = null, bestScore = 1e9;
+  const walk = (root) => {
+    for (const el of root.querySelectorAll('*')) {
+      if (el.shadowRoot) walk(el.shadowRoot);
+      if (el === cur || !el.matches(sel) || el.tabIndex < 0 || el.disabled ||
+          el.inert) continue;
+      const r = el.getBoundingClientRect();
+      if (r.width < 4 || r.height < 4 || r.bottom < 0 || r.top > H ||
+          r.right < 0 || r.left > W) continue;
+      let main, side;
+      if (d === 'down') {
+        if (r.top < o.bottom - 4) continue;
+        main = r.top - o.bottom;
+        side = hgap(r);
+      } else if (d === 'up') {
+        if (r.bottom > o.top + 4) continue;
+        main = o.top - r.bottom;
+        side = hgap(r);
+      } else if (d === 'right') {
+        if (r.left < o.right - 4) continue;
+        main = r.left - o.right;
+        side = vgap(r);
+      } else {
+        if (r.right > o.left + 4) continue;
+        main = o.left - r.right;
+        side = vgap(r);
+      }
+      const cs = getComputedStyle(el);
+      if (cs.visibility === 'hidden' || cs.display === 'none') continue;
+      const score = Math.max(main, 0) + 2 * side +
+          0.1 * Math.hypot((r.left + r.right) / 2 - ocx, (r.top + r.bottom) / 2 - ocy);
+      if (score < bestScore) { bestScore = score; best = el; }
+    }
+  };
+  walk(document);
+  if (!best) return false;
+  best.focus({focusVisible: true});
+  best.scrollIntoView({block: 'nearest', inline: 'nearest'});
+  return best.tagName + (best.id ? '#' + best.id : '');
+}))JS";
+
+bool IsTvWebUiPage(content::WebContents* contents) {
+  return contents &&
+         contents->GetLastCommittedURL().SchemeIs(content::kChromeUIScheme);
+}
+}  // namespace
+
+void BrowserView::RunTvWebUiNav(const char* direction, bool from_edge) {
+  content::WebContents* contents = GetActiveWebContents();
+  if (!IsTvWebUiPage(contents)) {
+    return;
+  }
+  std::u16string script = kTvWebUiNavScript;
+  script += u"('" + base::ASCIIToUTF16(direction) + u"', " +
+            (from_edge ? u"true" : u"false") + u")";
+  const bool up = std::string_view(direction) == "up";
+  contents->GetPrimaryMainFrame()->ExecuteJavaScriptInIsolatedWorld(
+      script,
+      base::BindOnce(
+          [](base::WeakPtr<BrowserView> view, bool up, base::Value moved) {
+            // UP above the page's first element goes to the toolbar.
+            const bool did_move =
+                moved.is_string() || (moved.is_bool() && moved.GetBool());
+            if (view && up && !did_move) {
+              view->FocusToolbar();
+            }
+          },
+          weak_ptr_factory_.GetWeakPtr(), up),
+      ISOLATED_WORLD_ID_CHROME_INTERNAL);
+}
