+namespace {
+// chromium-native (webOS): sees key presses before views' accelerators, so the
+// remote's arrows can leave the omnibox and move between toolbar, tabs and page.
+class TvRemoteKeyHandler : public ui::EventHandler, public aura::WindowObserver {
+ public:
+  TvRemoteKeyHandler(BrowserView* view, aura::Window* window)
+      : view_(view), window_(window) {
+    window_->AddPreTargetHandler(this, ui::EventTarget::Priority::kSystem);
+    window_->AddObserver(this);
+  }
+  ~TvRemoteKeyHandler() override { Detach(); }
+
+  void OnKeyEvent(ui::KeyEvent* event) override {
+    if (view_->HandleTvRemoteKey(event)) {
+      event->StopPropagation();
+    }
+  }
+  // chromium-native (patch 0022): a pointer click (Magic Remote OK in pointer
+  // mode) may open the keyboard if it lands on a text field.
+  void OnMouseEvent(ui::MouseEvent* event) override {
+    if (event->type() == ui::EventType::kMousePressed &&
+        event->IsOnlyLeftMouseButton()) {
+      ui::InputMethodNevaObserver::AllowShowOnce();
+    }
+  }
+  void OnWindowDestroying(aura::Window* window) override { Detach(); }
+
+ private:
+  void Detach() {
+    if (window_) {
+      window_->RemovePreTargetHandler(this);
+      window_->RemoveObserver(this);
+      window_ = nullptr;
+    }
+  }
+  raw_ptr<BrowserView> view_;
+  raw_ptr<aura::Window> window_;
+};
+}  // namespace
+#endif  // defined(USE_AURA)
