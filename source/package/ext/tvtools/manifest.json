{
  "manifest_version": 3,
  "name": "TV Tools",
  "short_name": "TV Tools",
  "version": "2.4.1",
  "description": "Video quality limits for every site, TV website versions, lite mode and memory savers for the TV.",
  "key": "",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "TV Tools",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "bg.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "page.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "exclude_matches": [
        "*://challenges.cloudflare.com/*"
      ]
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "settings.js",
        "bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "exclude_matches": [
        "*://challenges.cloudflare.com/*"
      ]
    }
  ]
}
